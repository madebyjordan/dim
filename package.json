{
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "setup": "node ./scripts/task.mjs setup",
    "build": "node ./scripts/build.mjs",
    "test:build": "node --test ./scripts/build.test.mjs",
    "dev": "node ./scripts/dev.mjs",
    "test:dev": "node --test ./scripts/dev-processes.test.mjs ./scripts/process-management.test.mjs",
    "dev:cleanup:codex": "node ./scripts/managed-process.mjs cleanup --owner codex",
    "test": "node ./scripts/task.mjs test",
    "nightfall:fmt": "cargo fmt --manifest-path vendor/nightfall/Cargo.toml --all -- --check",
    "nightfall:test": "cargo test --manifest-path vendor/nightfall/Cargo.toml --locked --all-targets --no-default-features --features cuda,ssa_transmux",
    "nightfall:clippy": "cargo clippy --manifest-path vendor/nightfall/Cargo.toml --locked --all-targets --no-default-features --features cuda,ssa_transmux",
    "test:installer": "node --test ./scripts/install.test.mjs ./scripts/package-manager.test.mjs ./scripts/prepare-pnpm.test.mjs ./scripts/windows-launcher.test.mjs ./scripts/windows-scripts.test.mjs ./scripts/windows-toolchain.test.mjs",
    "release:initial": "node ./scripts/release.mjs initial",
    "release:patch": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "release:validate": "node ./scripts/task.mjs release-validate",
    "test:release": "node --test ./scripts/release.test.mjs"
  }
}
