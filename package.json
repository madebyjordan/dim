{
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "setup": "./install.sh",
    "build": "./scripts/bootstrap.sh",
    "dev": "node ./scripts/dev.mjs",
    "test:dev": "node --test ./scripts/dev-processes.test.mjs",
    "test": "./scripts/test.sh",
    "test:installer": "node --test ./scripts/install.test.mjs ./scripts/package-manager.test.mjs ./scripts/prepare-pnpm.test.mjs ./scripts/windows-launcher.test.mjs ./scripts/windows-scripts.test.mjs ./scripts/windows-toolchain.test.mjs",
    "release:initial": "node ./scripts/release.mjs initial",
    "release:patch": "node ./scripts/release.mjs patch",
    "release:minor": "node ./scripts/release.mjs minor",
    "release:major": "node ./scripts/release.mjs major",
    "release:validate": "./scripts/validate-release.sh",
    "test:release": "node --test ./scripts/release.test.mjs"
  }
}
