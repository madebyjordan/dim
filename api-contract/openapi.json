{
  "openapi": "3.1.0",
  "info": { "title": "Eclipse active API", "version": "1.0.0" },
  "servers": [{ "url": "/api/v1" }],
  "paths": {
    "/auth/login": { "post": { "operationId": "login", "requestBody": { "$ref": "#/components/requestBodies/Login" }, "responses": { "200": { "$ref": "#/components/responses/Login" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/auth/register": { "post": { "operationId": "register", "requestBody": { "$ref": "#/components/requestBodies/Login" }, "responses": { "200": { "$ref": "#/components/responses/Register" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/auth/admin_exists": { "get": { "operationId": "adminExists", "responses": { "200": { "description": "Admin state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminExists" } } } } } } },
    "/auth/logout": { "post": { "operationId": "logout", "security": [{ "token": [] }, { "sessionCookie": [] }], "responses": { "204": { "description": "Session revoked" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/auth/whoami": { "get": { "operationId": "whoAmI", "security": [{ "token": [] }, { "sessionCookie": [] }], "responses": { "200": { "description": "Current user", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/user/password": { "patch": { "operationId": "changePassword", "security": [{ "token": [] }], "requestBody": { "description": "Passwords", "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChangePassword" } } } }, "responses": { "200": { "description": "Changed" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/user": { "delete": { "operationId": "deleteAccount", "security": [{ "token": [] }], "requestBody": { "description": "Password confirmation", "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeleteAccount" } } } }, "responses": { "200": { "description": "Deleted" }, "401": { "$ref": "#/components/responses/Error" } } } },
    "/library": {
      "get": { "operationId": "listLibraries", "security": [{ "token": [] }], "responses": { "200": { "description": "Libraries", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Library" } } } } }, "401": { "$ref": "#/components/responses/Error" } } },
      "post": { "operationId": "createLibrary", "security": [{ "token": [] }], "requestBody": { "description": "Library", "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateLibrary" } } } }, "responses": { "200": { "description": "Created library", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateLibraryResponse" } } } }, "400": { "$ref": "#/components/responses/Error" } } }
    },
    "/library/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getLibrary", "security": [{ "token": [] }], "responses": { "200": { "description": "Library", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Library" } } } }, "404": { "$ref": "#/components/responses/Error" } } }, "patch": { "operationId": "updateLibrary", "security": [{ "token": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateLibrary" } } } }, "responses": { "200": { "description": "Updated library", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Library" } } } }, "404": { "$ref": "#/components/responses/Error" } } }, "delete": { "operationId": "deleteLibrary", "security": [{ "token": [] }], "responses": { "204": { "description": "Deleted" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/library/{id}/media": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getLibraryMedia", "security": [{ "token": [] }], "responses": { "200": { "description": "Media grouped under the library name", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/components/schemas/MediaSummary" } } } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/library/{id}/unmatched": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getUnmatched", "security": [{ "token": [] }], "responses": { "200": { "description": "Unmatched files", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UnmatchedFiles" } } } } } } },
    "/library/{id}/scan": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getLibraryScan", "security": [{ "token": [] }], "responses": { "200": { "description": "Scan status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScanStatus" } } } } } }, "post": { "operationId": "retryLibraryScan", "security": [{ "token": [] }], "responses": { "200": { "description": "Queued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ScanStatus" } } } }, "409": { "$ref": "#/components/responses/Error" } } } },
    "/media/{id}": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getMedia", "security": [{ "token": [] }], "responses": { "200": { "description": "Media", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Media" } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/media/{id}/files": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "getMediaFiles", "security": [{ "token": [] }], "responses": { "200": { "description": "Playable files associated with the media", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/MediaFile" } } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/media/{id}/rematch": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "rematchMedia", "security": [{ "token": [] }], "requestBody": { "description": "Match", "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RematchMedia" } } } }, "responses": { "200": { "description": "Rematched" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/media/{id}/progress": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "post": { "operationId": "saveProgress", "security": [{ "token": [] }], "parameters": [{ "name": "offset", "in": "query", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Saved" } } } },
    "/search": { "get": { "operationId": "searchMedia", "security": [{ "token": [] }], "parameters": [{ "name": "query", "in": "query", "required": true, "schema": { "type": "string" } }, { "name": "quick", "in": "query", "required": false, "schema": { "type": "boolean" } }], "responses": { "200": { "description": "Matching media", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/SearchResult" } } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/filebrowser": { "get": { "operationId": "listDirectories", "security": [{ "token": [] }], "parameters": [{ "name": "path", "in": "query", "required": false, "schema": { "type": "string" } }], "responses": { "200": { "description": "Readable directories", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DirectoryListing" } } } }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/filebrowser/roots": { "get": { "operationId": "listStorageRoots", "security": [{ "token": [] }], "responses": { "200": { "description": "Usable storage roots", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/StorageRoot" } } } } }, "403": { "$ref": "#/components/responses/Error" } } } },
    "/media/tmdb_search": { "get": { "operationId": "searchExternalMedia", "security": [{ "token": [] }], "parameters": [{ "name": "query", "in": "query", "required": true, "schema": { "type": "string" } }, { "name": "media_type", "in": "query", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Results", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/ExternalMedia" } } } } } } } },
    "/stream/{id}/capabilities": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "inspectPlaybackCapabilities", "security": [{ "token": [] }, { "sessionCookie": [] }], "responses": { "200": { "description": "Source-specific browser capability request", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlaybackCapabilityInspection" } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/stream/{id}/manifest": { "parameters": [{ "$ref": "#/components/parameters/Id" }], "get": { "operationId": "createPlaybackSession", "security": [{ "token": [] }, { "sessionCookie": [] }], "parameters": [{ "name": "force_ass", "in": "query", "required": false, "schema": { "type": "boolean", "default": false } }, { "name": "target", "in": "query", "required": false, "schema": { "type": "string", "enum": ["browser", "airplay"], "default": "browser" } }, { "name": "capabilities", "in": "query", "required": false, "description": "JSON-encoded structured results for the exact source audio and video configurations queried with canPlayType, MediaSource, and Media Capabilities.", "schema": { "type": "string" } }], "responses": { "200": { "description": "Playback session", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlaybackSession" } } } }, "429": { "$ref": "#/components/responses/Error" } } } },
    "/stream/{gid}/state/get_stderr": { "parameters": [{ "$ref": "#/components/parameters/Gid" }], "get": { "operationId": "getPlaybackFailure", "security": [{ "token": [] }, { "sessionCookie": [] }], "responses": { "200": { "description": "Process output", "content": { "text/plain": { "schema": { "type": "string" } } } }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/stream/{gid}/state/remote-route": { "parameters": [{ "$ref": "#/components/parameters/Gid" }], "get": { "operationId": "getRemotePlaybackStatus", "security": [{ "token": [] }, { "sessionCookie": [] }], "responses": { "200": { "description": "Correlated remote playback delivery status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RemotePlaybackStatus" } } } }, "404": { "$ref": "#/components/responses/Error" } } }, "put": { "operationId": "updateRemotePlaybackState", "security": [{ "token": [] }, { "sessionCookie": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["state"], "properties": { "state": { "$ref": "#/components/schemas/RemotePlaybackState" } } } } } }, "responses": { "204": { "description": "Remote playback state recorded" }, "404": { "$ref": "#/components/responses/Error" } } } },
    "/stream/{gid}/state/kill": { "parameters": [{ "$ref": "#/components/parameters/Gid" }], "delete": { "operationId": "killPlaybackSession", "security": [{ "token": [] }, { "sessionCookie": [] }], "responses": { "200": { "description": "Stopped" }, "404": { "$ref": "#/components/responses/Error" } } } }
  },
  "components": {
    "securitySchemes": { "token": { "type": "apiKey", "in": "header", "name": "Authorization" }, "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "dim_session" } },
    "parameters": { "Id": { "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }, "Gid": { "name": "gid", "in": "path", "required": true, "schema": { "type": "string" } } },
    "requestBodies": { "Login": { "description": "Credentials", "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } } },
    "responses": { "Login": { "description": "Token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } } }, "Register": { "description": "Created account and token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterResponse" } } } }, "Error": { "description": "Structured error", "headers": { "x-request-id": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorEnvelope" } } } } },
    "schemas": {
      "ApiErrorEnvelope": { "type": "object", "required": ["error", "request_id"], "properties": { "error": { "$ref": "#/components/schemas/ApiError" }, "request_id": { "type": "string" } } },
      "ApiError": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": { "type": "object", "additionalProperties": true } } },
      "LoginRequest": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string", "minLength": 1, "maxLength": 64 }, "password": { "type": "string", "minLength": 1, "maxLength": 1024 }, "invite_token": { "type": ["string", "null"] } } },
      "LoginResponse": { "type": "object", "required": ["token"], "properties": { "token": { "type": "string" } } },
      "RegisterResponse": { "type": "object", "required": ["token", "username"], "properties": { "token": { "type": "string" }, "username": { "type": "string" } } },
      "AdminExists": { "type": "object", "required": ["exists"], "properties": { "exists": { "type": "boolean" } } },
      "User": { "type": "object", "required": ["username", "roles", "spentWatching"], "properties": { "username": { "type": "string" }, "roles": { "type": "array", "items": { "type": "string" } }, "picture": { "type": ["string", "null"] }, "spentWatching": { "type": "integer" } } },
      "ChangePassword": { "type": "object", "required": ["old_password", "new_password"], "properties": { "old_password": { "type": "string" }, "new_password": { "type": "string" } } },
      "DeleteAccount": { "type": "object", "required": ["password"], "properties": { "password": { "type": "string" } } },
      "CreateLibrary": { "type": "object", "required": ["name", "locations", "media_type"], "properties": { "name": { "type": "string" }, "locations": { "type": "array", "items": { "type": "string" } }, "media_type": { "type": "string", "enum": ["movie", "tv"] } } },
      "CreateLibraryResponse": { "type": "object", "required": ["id", "scan_status"], "properties": { "id": { "type": "integer" }, "scan_status": { "type": "string", "enum": ["scanning"] } } },
      "Library": { "type": "object", "required": ["id", "name", "locations", "media_type", "auto_scan"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "locations": { "type": "array", "items": { "type": "string" } }, "media_type": { "type": "string" }, "auto_scan": { "type": "boolean" }, "scan_status": { "type": "string", "enum": ["scanning", "complete", "failed", "cancelled"] } }, "additionalProperties": true },
      "UpdateLibrary": { "type": "object", "required": ["auto_scan"], "properties": { "auto_scan": { "type": "boolean" } }, "additionalProperties": false },
      "Chapters": { "type": "object", "required": ["credits"], "properties": { "credits": { "type": "integer" } } },
      "MediaSummary": { "type": "object", "required": ["id", "name"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "poster_path": { "type": ["string", "null"] } } },
      "SearchResult": { "type": "object", "required": ["id", "library_id", "name"], "properties": { "id": { "type": "integer" }, "library_id": { "type": "integer" }, "name": { "type": "string" }, "poster_path": { "type": ["string", "null"] } } },
      "Media": { "type": "object", "required": ["id", "name", "library_id", "media_type", "genres", "duration"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "library_id": { "type": "integer" }, "media_type": { "type": "string" }, "genres": { "type": "array", "items": { "type": "string" } }, "duration": { "type": "integer" }, "progress": { "type": "integer" }, "description": { "type": ["string", "null"] }, "added": { "type": ["string", "null"] }, "backdrop_path": { "type": ["string", "null"] }, "poster_path": { "type": ["string", "null"] }, "chapters": { "$ref": "#/components/schemas/Chapters" }, "episode": { "type": "integer" }, "next_episode_id": { "type": "integer" }, "play_btn_id": { "type": "integer" }, "prev_episode_id": { "type": "integer" }, "rating": { "type": "number" }, "season": { "type": "integer" }, "season_count": { "type": "integer" }, "start_year": { "type": ["integer", "null"] }, "end_year": { "type": ["integer", "null"] }, "ongoing": { "type": "boolean" }, "year": { "type": "integer" }, "tags": { "type": "object", "additionalProperties": true } }, "additionalProperties": true },
      "MediaFile": { "type": "object", "required": ["id", "library_id", "target_file", "raw_name", "manual_override"], "properties": { "id": { "type": "integer" }, "media_id": { "type": ["integer", "null"] }, "library_id": { "type": "integer" }, "target_file": { "type": "string" }, "raw_name": { "type": "string" }, "raw_year": { "type": ["integer", "null"] }, "quality": { "type": ["string", "null"] }, "codec": { "type": ["string", "null"] }, "container": { "type": ["string", "null"] }, "audio": { "type": ["string", "null"] }, "original_resolution": { "type": ["string", "null"] }, "duration": { "type": ["integer", "null"] }, "episode": { "type": ["integer", "null"] }, "season": { "type": ["integer", "null"] }, "corrupt": { "type": ["boolean", "null"] }, "channels": { "type": ["integer", "null"] }, "profile": { "type": ["string", "null"] }, "audio_language": { "type": ["string", "null"] }, "manual_override": { "type": "boolean" } } },
      "DirectoryEntry": { "type": "object", "required": ["name", "path"], "properties": { "name": { "type": "string" }, "path": { "type": "string" } } },
      "DirectoryListing": { "type": "object", "required": ["current", "parent", "directories"], "properties": { "current": { "type": "string" }, "parent": { "type": ["string", "null"] }, "directories": { "type": "array", "items": { "$ref": "#/components/schemas/DirectoryEntry" } } } },
      "StorageRoot": { "type": "object", "required": ["display_name", "path", "available_bytes", "kind"], "properties": { "display_name": { "type": "string" }, "path": { "type": "string" }, "available_bytes": { "type": "integer" }, "kind": { "type": "string", "enum": ["fixed", "removable", "network"] } } },
      "UnmatchedMediaFile": { "type": "object", "required": ["type"], "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "folder": { "type": "string" }, "duration": { "type": "integer" }, "file": { "type": "string" }, "files": { "type": "array", "items": { "$ref": "#/components/schemas/UnmatchedMediaFile" } }, "type": { "type": "string", "enum": ["directory", "file"] } } },
      "UnmatchedFiles": { "type": "object", "required": ["count", "files"], "properties": { "count": { "type": "integer" }, "files": { "type": "array", "items": { "$ref": "#/components/schemas/UnmatchedMediaFile" } } } },
      "ScanStatus": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["scanning", "complete", "failed", "cancelled"] }, "stage": { "type": "string" }, "discovered": { "type": "integer" }, "processed": { "type": "integer" }, "committed": { "type": "integer" }, "skipped": { "type": "integer" }, "failed": { "type": "integer" }, "requested_at": { "type": ["string", "null"] }, "started_at": { "type": ["string", "null"] }, "finished_at": { "type": ["string", "null"] }, "last_progress_at": { "type": ["string", "null"] }, "elapsed_seconds": { "type": "integer" }, "seconds_since_progress": { "type": ["integer", "null"] }, "error_summary": { "type": ["string", "null"] } } },
      "RematchMedia": { "type": "object", "required": ["external_id", "media_type"], "properties": { "external_id": { "type": "string" }, "media_type": { "type": "string", "enum": ["movie", "tv"] } } },
      "ExternalMedia": { "type": "object", "additionalProperties": true },
      "VideoCapabilityRequest": { "type": "object", "required": ["content_type", "codec", "codec_descriptor", "width", "height", "bitrate", "frame_rate", "hdr"], "properties": { "content_type": { "type": "string" }, "codec": { "type": "string" }, "codec_descriptor": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" }, "bitrate": { "type": "integer" }, "frame_rate": { "type": "number" }, "hdr": { "type": "boolean" }, "hdr_metadata_type": { "type": "string" }, "color_gamut": { "type": "string" }, "transfer_function": { "type": "string" } } },
      "AudioCapabilityRequest": { "type": "object", "required": ["stream_index", "content_type", "codec", "codec_descriptor", "channels", "bitrate", "sample_rate"], "properties": { "stream_index": { "type": "integer" }, "content_type": { "type": "string" }, "codec": { "type": "string" }, "codec_descriptor": { "type": "string" }, "channels": { "type": "integer" }, "bitrate": { "type": "integer" }, "sample_rate": { "type": "integer" } } },
      "PlaybackCapabilityInspection": { "type": "object", "required": ["video", "audio", "server_remux_supported", "probe_source"], "properties": { "video": { "type": ["object", "null"], "properties": { "content_type": { "type": "string" }, "codec": { "type": "string" }, "codec_descriptor": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" }, "bitrate": { "type": "integer" }, "frame_rate": { "type": "number" }, "hdr": { "type": "boolean" }, "hdr_metadata_type": { "type": "string" }, "color_gamut": { "type": "string" }, "transfer_function": { "type": "string" } } }, "audio": { "type": "array", "items": { "$ref": "#/components/schemas/AudioCapabilityRequest" } }, "server_remux_supported": { "type": "boolean" }, "probe_source": { "type": "string", "enum": ["ingestion", "fallback"] } } },
      "PlaybackTrack": { "type": "object", "required": ["id", "content_type", "set_id", "is_direct", "mime", "codecs", "bandwidth", "average_bandwidth", "chunk_path", "is_default", "label", "target_duration"], "properties": { "id": { "type": "string" }, "content_type": { "type": "string", "enum": ["video", "audio", "subtitle"] }, "set_id": { "type": "integer" }, "is_direct": { "type": "boolean" }, "mime": { "type": "string" }, "codecs": { "type": "string" }, "bandwidth": { "type": "integer" }, "average_bandwidth": { "type": "integer" }, "height": { "type": "string" }, "duration": { "type": ["integer", "null"] }, "chunk_path": { "type": "string" }, "init_seg": { "type": ["string", "null"] }, "is_default": { "type": "boolean" }, "label": { "type": "string" }, "lang": { "type": ["string", "null"] }, "target_duration": { "type": "integer" }, "audio_channels": { "type": ["integer", "null"] }, "frame_rate": { "type": ["number", "null"] }, "video_range": { "type": ["string", "null"] } }, "additionalProperties": true },
      "AudioPlaybackPlan": { "type": "object", "required": ["source", "reported_capability", "chosen_action", "decision_reason"], "properties": { "source": { "type": "object", "additionalProperties": true }, "reported_capability": { "type": ["object", "null"], "additionalProperties": true }, "chosen_action": { "type": "string", "enum": ["preserve", "transcode_aac"] }, "decision_reason": { "type": "string" } } },
      "PlaybackPlan": { "type": "object", "required": ["target", "capability_evidence", "preferred_strategy", "direct_play_supported", "decision_reason", "renditions", "audio"], "properties": { "target": { "type": "string", "enum": ["browser", "airplay"] }, "capability_evidence": { "type": "string" }, "preferred_strategy": { "type": "string", "enum": ["direct_play", "transcode"] }, "direct_play_supported": { "type": "boolean" }, "decision_reason": { "type": "string" }, "renditions": { "type": "array", "items": { "type": "object", "required": ["height", "bitrate"], "properties": { "height": { "type": "integer" }, "bitrate": { "type": "integer" } } } }, "audio": { "type": "array", "items": { "$ref": "#/components/schemas/AudioPlaybackPlan" } } } },
      "RemotePlaybackResource": { "type": "object", "required": ["kind", "url"], "properties": { "kind": { "type": "string", "enum": ["airplay"] }, "url": { "type": "string" } } },
      "RemotePlaybackState": { "type": "string", "enum": ["prepared", "handoff_requested", "wireless_route_reported", "media_delivery_confirmed", "handoff_stalled", "failed", "disconnected"] },
      "RemoteRequestAttribution": { "type": "string", "enum": ["sender_preflight", "sender_or_local_proxy", "webkit_route_proxy_candidate", "apple_media_intermediary_candidate", "remote_network_candidate", "origin_unresolved", "disconnected_or_stale"] },
      "RemoteHlsStage": { "type": "string", "enum": ["master_playlist", "media_playlist", "init_fragment", "media_segment", "unknown"] },
      "RemotePlaybackStatus": { "type": "object", "required": ["state", "successful_remote_inits", "successful_remote_segments", "route_loss_reported"], "properties": { "state": { "$ref": "#/components/schemas/RemotePlaybackState" }, "handoff_elapsed_ms": { "type": ["integer", "null"] }, "successful_remote_inits": { "type": "integer" }, "successful_remote_segments": { "type": "integer" }, "last_request_attribution": { "oneOf": [{ "$ref": "#/components/schemas/RemoteRequestAttribution" }, { "type": "null" }] }, "last_request_stage": { "oneOf": [{ "$ref": "#/components/schemas/RemoteHlsStage" }, { "type": "null" }] }, "last_remote_segment_path": { "type": ["string", "null"] }, "last_remote_segment_elapsed_ms": { "type": ["integer", "null"] }, "delivery_evidence_remaining_ms": { "type": ["integer", "null"] }, "route_loss_reported": { "type": "boolean" } } },
      "PlaybackSession": { "type": "object", "required": ["gid", "tracks", "playback_plan"], "properties": { "gid": { "type": "string" }, "tracks": { "type": "array", "items": { "$ref": "#/components/schemas/PlaybackTrack" } }, "playback_plan": { "$ref": "#/components/schemas/PlaybackPlan" }, "remote": { "oneOf": [{ "$ref": "#/components/schemas/RemotePlaybackResource" }, { "type": "null" }] } } },
      "WebSocketAuthenticate": { "type": "object", "required": ["type", "token"], "properties": { "type": { "const": "authenticate" }, "token": { "type": "string" } } },
      "WebSocketEvent": { "type": "object", "required": ["type", "id"], "properties": { "type": { "type": "string", "enum": ["EventNewCard", "EventRemoveCard", "EventNewLibrary", "EventRemoveLibrary", "EventStreamIsReady", "EventStreamStats", "EventStartedScanning", "EventStoppedScanning", "EventScanFailed", "EventScanCancelled", "EventAuthOk", "EventAuthErr", "MediafileMatched"] }, "id": { "type": "integer" } }, "additionalProperties": true }
    }
  }
